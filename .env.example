DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require
PORT=3000

# Auth
SESSION_COOKIE_NAME=nd_session
SESSION_DAYS=30

# Seeded on first boot if no users exist
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-after-first-login

# Human-facing app name used in MFA authenticator display
APP_NAME=Network Design
